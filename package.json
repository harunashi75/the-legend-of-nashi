{
  "name": "the-legend-of-nashi",
  "productName": "The Legend of Nashi",
  "version": "0.12.0",
  "private": true,
  "description": "The Legend of Nashi — application de bureau (Electron).",
  "desktopName": "legend-of-nashi.desktop",
  "main": "app/main.js",
  "scripts": {
    "build": "node tools/build.cjs",
    "build:dev": "node tools/build.cjs --extensions",
    "check": "node tools/check.cjs",
    "test": "node --test --test-timeout=120000 \"tests/*.test.cjs\"",
    "lint": "eslint .",
    "typecheck": "tsc -p src/canaan/shared/jsconfig.json",
    "format": "prettier --write \"src/canaan/**/*.{js,css}\" \"app/**/*.js\" \"online/**/*.cjs\" \"tools/**/*.cjs\" eslint.config.mjs",
    "format:check": "prettier --check \"src/canaan/**/*.{js,css}\" \"app/**/*.js\" \"online/**/*.cjs\" \"tools/**/*.cjs\" eslint.config.mjs",
    "start": "node tools/build.cjs --extensions && node tools/run_app.cjs",
    "app": "node tools/run_app.cjs",
    "dist:linux": "node tools/build.cjs && electron-builder --linux",
    "dist:win": "node tools/build.cjs && electron-builder --win",
    "relay": "node online/relay.cjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "44.9.3",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-scope": "9.1.2",
    "espree": "11.2.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "steamworks.js": "0.4.0",
    "ws": "8.22.0"
  },
  "author": "harunashi75"
}
