{
  // Vérification des types de shared/ (JavaScript annoté en JSDoc) : npm run typecheck.
  // Aucune bibliothèque DOM : une API du navigateur dans shared/ est une erreur de type (shared/ reste pur).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["./**/*.js"]
}
